    for f in {input.fa_files}; do
        bname=$(basename ${f} '_mapped.fa')

        miRDeep2.pl ${f} {input.hsa2_fa} {config[directories][mirdeep2_map]}/${bname}_mapped_vs_hsa.arf \
            {input.mature_fa} none {input.hairpin_fa} -t {params.species} -P -v -z $bname \
            2> {config[directories][mirdeep2_map]}/${bname}_miRDeep2_log.txt

        # Find the actual timestamp prefix
        timestamp=$(ls -td result_*${bname}.html | head -n1 | sed "s/result_\(.*\)${bname}.html/\1/")

        # Move outputs to results/ folder (using safe fallbacks)
        mv result_${timestamp}${bname}.html {config[directories][mirdeep2_map]}/result_${bname}.html
        mv result_${timestamp}${bname}.csv {config[directories][mirdeep2_map]}/result_${bname}.csv
        mv result_${timestamp}${bname}.bed {config[directories][mirdeep2_map]}/result_${bname}.bed || true
        mv output.mrd {config[directories][mirdeep2_map]}/output_${bname}.mrd || true
        mv expression_${timestamp}${bname}.html {config[directories][mirdeep2_map]}/expression_${bname}.html || true
        mv error_${timestamp}${bname}.log {config[directories][mirdeep2_map]}/error_${bname}.log || true
        mv miRNAs_expressed_all_samples_${timestamp}${bname}.csv {config[directories][mirdeep2_map]}/miRNAs_expressed_all_samples_${bname}.csv || true
        mv pdfs_${timestamp}${bname} {config[directories][mirdeep2_map]}/pdfs_${bname} || true
        mv mirna_results_${timestamp}${bname} {config[directories][mirdeep2_map]}/mirna_results_${bname} || true

        # Locate and move survey.csv from subfolder
        survey_file=$(find mirdeep_runs -name "survey.csv" | grep ${bname} | head -n1)
        if [[ -f "$survey_file" ]]; then
            cp "$survey_file" {config[directories][mirdeep2_map]}/survey_${bname}.csv
        fi

        # Move auxiliary folders
        mv expression_analyses {config[directories][mirdeep2_map]}/expression_analyses_${bname} || true
        mv mirdeep_runs {config[directories][mirdeep2_map]}/mirdeep_runs_${bname} || true
        mv dir_prepare_signature* {config[directories][mirdeep2_map]}/prep_signatures_${bname} || true
    done
    
